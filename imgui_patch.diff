diff --git a/imconfig.h b/imconfig.h
--- a/imconfig.h
+++ b/imconfig.h
@@ -16,0 +17,7 @@
+// TRex stores the OpenGL texture name in the low 32 bits and the source
+// channel count in the high byte. Other renderers keep using the unmodified
+// ImTextureID value.
+#define IMGUI_TREX_OPENGL_TEXTURE_ID(_NAME, _CHANNELS) ((ImTextureID)((unsigned long long)(_NAME) | ((unsigned long long)(_CHANNELS) << 56)))
+#define IMGUI_TREX_OPENGL_TEXTURE_NAME(_ID) ((unsigned int)((unsigned long long)(_ID) & 0xFFFFFFFFULL))
+#define IMGUI_TREX_OPENGL_TEXTURE_CHANNELS(_ID) ((unsigned int)(((unsigned long long)(_ID) >> 56) & 0xFFULL))
+
